DEBUG=false

# Ingestion + retrieval tuning
CHUNK_SIZE=750
CHUNK_OVERLAP=140
TOP_K=4
SCORE_THRESHOLD=0.28
HYBRID_VECTOR_WEIGHT=0.68
HYBRID_LEXICAL_WEIGHT=0.32

# Embedding backend: hashing (default) or sentence-transformers
EMBEDDING_BACKEND=hashing
EMBEDDING_DIMENSION=1536

# Comma-separated origins for frontend apps
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional OpenAI generation
ALLOW_OPENAI_GENERATION=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
